{
  "name": "sui-toolkit",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pnpm --filter sui-toolkit-client start",
    "build": "pnpm --filter sui-toolkit-client build",
    "lint": "pnpm --filter sui-toolkit-client lint",
    "lint:fix": "pnpm --filter sui-toolkit-client lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
